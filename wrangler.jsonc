{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toastmasters-czestochowa",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  // nodejs_compat jest potrzebne bibliotece worker-mailer (SMTP przez gniazda TCP)
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // mniejszy pakiet = tańszy zimny start (darmowy plan liczy CPU, limit 10 ms)
  "minify": true,

  // Własna domena (strefa w Cloudflare). Rekordy DNS i certyfikaty SSL tworzy Cloudflare przy deployu.
  // Adres *.workers.dev nadal działa — linki wysłane wcześniej się nie psują.
  "routes": [
    { "pattern": "toastmasters.pro", "custom_domain": true },
    { "pattern": "www.toastmasters.pro", "custom_domain": true }
  ],
  // workers.dev zostaje włączony, ale przekierowuje na CANONICAL_HOST (stare linki z tokenami dalej działają)
  "workers_dev": true,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toastmasters-czestochowa",
      "database_id": "6cb80b14-89a8-4e2f-b125-d20ec41478ee",
      "migrations_dir": "migrations"
    }
  ],

  // Pliki konkursowe (rollupy). Domyślnie Workers KV — działa bez podpinania karty.
  // Po włączeniu R2 w panelu Cloudflare odkomentuj "r2_buckets" — aplikacja sama przełączy się na R2.
  "kv_namespaces": [{ "binding": "FILES_KV", "id": "bbdd0c91d7814ca88680d4c47153653a" }],
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "toastmasters-czestochowa-pliki" }],

  // Workers AI: darmowe 10 000 „neuronów” dziennie, przy Qwenie 3.8 to ok. 25-30 ocen projektów.
  "ai": { "binding": "AI" },

  "vars": {
    "CANONICAL_HOST": "toastmasters.pro",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "toastmastersczwa@gmail.com",
    "MAIL_FROM_NAME": "Toastmasters Częstochowa",
    // Gmail: ok. 500 maili/dobę na konto — zostawiamy zapas na ręczną korespondencję klubu
    "MAIL_DAILY_LIMIT": "300",
    // "workers-ai" (darmowe) albo "claude" (wymaga sekretu ANTHROPIC_API_KEY)
    "AI_PROVIDER": "workers-ai",
    // test 20.11.2026 na 9 projektach z wstawionymi błędami (trafność, czas, neurony na ocenę):
    //   Qwen 3.8 bez myślenia 16/16, 15-70 s, ok. 320 (ok. 25-30 ocen dziennie za darmo)
    //   Gemma 4 26B bez myślenia 14/16, ok. 23 s, ok. 35 (ok. 290 ocen)  "@cf/google/gemma-4-26b-a4b-it"
    //   Mistral Small 3.1 12/16, ok. 16 s, ok. 120 (ok. 80 ocen), myli oficjalne logo z nieoficjalnym
    "WORKERS_AI_MODEL": "@cf/qwen/qwen3.8-27b",
    "CLAUDE_MODEL": "claude-opus-5-5",
    // limity ocen AI na osobę (darmowa pula Cloudflare to ok. 25-30 ocen Qwenem dziennie na cały klub)
    "AI_DAILY_LIMIT": "8",
    "AI_COOLDOWN_MINUTES": "5",
    // twardy dzienny limit ocen AI dla całego klubu (bezpiecznik kosztów, limit wydatków Cloudflare nie obejmuje Workers AI).
    // Konto jest na Workers Paid (od 20.11.2026): ok. 25 pierwszych ocen dziennie z darmowej puli, każda kolejna
    // ok. 1,3 grosza, więc 100 dziennie to najwyżej ok. 1 zł na dzień. Na darmowym planie ustaw 25.
    "AI_CLUB_DAILY_LIMIT": "100"
  }
}
