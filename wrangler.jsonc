{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toastmasters-czestochowa",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  // nodejs_compat jest potrzebne bibliotece worker-mailer (SMTP przez gniazda TCP)
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // mniejszy pakiet = tańszy zimny start (darmowy plan liczy CPU, limit 10 ms)
  "minify": true,

  // Własna domena (strefa w Cloudflare). Rekordy DNS i certyfikaty SSL tworzy Cloudflare przy deployu.
  // Adres *.workers.dev nadal działa — linki wysłane wcześniej się nie psują.
  "routes": [
    { "pattern": "toastmasters.pro", "custom_domain": true },
    { "pattern": "www.toastmasters.pro", "custom_domain": true }
  ],
  // workers.dev zostaje włączony, ale przekierowuje na CANONICAL_HOST (stare linki z tokenami dalej działają)
  "workers_dev": true,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toastmasters-czestochowa",
      "database_id": "6cb80b14-89a8-4e2f-b125-d20ec41478ee",
      "migrations_dir": "migrations"
    }
  ],

  // Pliki konkursowe (rollupy). Domyślnie Workers KV — działa bez podpinania karty.
  // Po włączeniu R2 w panelu Cloudflare odkomentuj "r2_buckets" — aplikacja sama przełączy się na R2.
  "kv_namespaces": [{ "binding": "FILES_KV", "id": "bbdd0c91d7814ca88680d4c47153653a" }],
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "toastmasters-czestochowa-pliki" }],

  // Workers AI — darmowe 10 000 „neuronów” dziennie, wystarcza na kilkadziesiąt ocen projektów.
  "ai": { "binding": "AI" },

  "vars": {
    "CANONICAL_HOST": "toastmasters.pro",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "toastmastersczwa@gmail.com",
    "MAIL_FROM_NAME": "Toastmasters Częstochowa",
    // Gmail: ok. 500 maili/dobę na konto — zostawiamy zapas na ręczną korespondencję klubu
    "MAIL_DAILY_LIMIT": "300",
    // "workers-ai" (darmowe) albo "claude" (wymaga sekretu ANTHROPIC_API_KEY)
    "AI_PROVIDER": "workers-ai",
    // zmierzone 20.11.2026: Mistral Small 3.1 ok. 13 s, Llama 4 Scout ok. 116 s, Qwen 3.8 ok. 42 s
    "WORKERS_AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "CLAUDE_MODEL": "claude-opus-5-5",
    // limity ocen AI na osobę: darmowa pula Cloudflare to ok. 65-70 ocen dziennie na cały klub
    "AI_DAILY_LIMIT": "8",
    "AI_COOLDOWN_MINUTES": "5"
  }
}
